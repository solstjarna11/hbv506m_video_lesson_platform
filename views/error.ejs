<%
const status = (error && error.statusCode) || null;
%>

<h1>
  <% if (status === 404) { %>
    Page not found
  <% } else if (status === 403) { %>
    Access denied
  <% } else if (status >= 500) { %>
    Server error
  <% } else { %>
    Something went wrong
  <% } %>
</h1>

<p><%= message || 'The request could not be completed.' %></p>

<% if (status && error && error.statusCode) { %>
  <p>Status: <%= status %></p>
<% } %>

<p>
  <% if (status === 404) { %>
    The page you were looking for does not exist.
  <% } else if (status === 403) { %>
    You do not have permission to access this resource.
  <% } else { %>
    Please try again later.
  <% } %>
</p>

<a href="/">Return to home page</a>